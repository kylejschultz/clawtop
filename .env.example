# Compose host paths and published port. On Unraid, use:
# CLAWTOP_DATA_PATH=/mnt/user/appdata/clawtop
# CLAWTOP_GATEWAYS_PATH=/mnt/user/appdata/clawtop/gateways.json
CLAWTOP_DATA_PATH=./data
CLAWTOP_GATEWAYS_PATH=./gateways.json
CLAWTOP_BIND_ADDRESS=127.0.0.1
CLAWTOP_HOST_PORT=3333

# Demo works without Gateway access or dashboard authentication.
CLAWTOP_MODE=demo
CLAWTOP_PORT=3333
CLAWTOP_HTTP_HOST=0.0.0.0
CLAWTOP_DATA_DIR=/data
CLAWTOP_MAX_SSE_CLIENTS=32

# Live mode requires dashboard HTTP Basic authentication by default.
# CLAWTOP_MODE=live
# CLAWTOP_HTTP_USERNAME=clawtop
# CLAWTOP_HTTP_PASSWORD=replace-with-a-long-random-password
# CLAWTOP_GATEWAYS_FILE=/run/secrets/clawtop-gateways.json

# Break glass only: allow a live dashboard with no HTTP authentication.
# Keep the listener loopback-only and use an authenticated reverse proxy.
# CLAWTOP_ALLOW_UNAUTHENTICATED=false

# Or provide the same Gateway JSON array inline. Keep .env private and out of Git.
# CLAWTOP_GATEWAYS=[{"id":"scruffy","name":"Scruffy / Unraid","url":"wss://scruffy.example.ts.net","token":"***"},{"id":"morrow","name":"Morrow / Lantern","url":"wss://lantern.example.ts.net","token":"***"}]

# Single-Gateway shorthand (use instead of CLAWTOP_GATEWAYS or its file).
# OPENCLAW_GATEWAY_ID=scruffy
# OPENCLAW_GATEWAY_NAME=Scruffy / Unraid
# OPENCLAW_GATEWAY_URL=wss://gateway.example.ts.net
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_PASSWORD=
# OPENCLAW_GATEWAY_TLS_FINGERPRINT=

# A shared token/password is needed for first pairing. After each Gateway saves a
# device token beneath /data/gateways/<id>, its shared credential may be removed.
