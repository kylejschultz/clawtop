{
  "name": "clawtop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Read-only terminal-style dashboard for OpenClaw Gateway activity",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build --silent && node dist/server.js",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings=0",
    "test": "npm run build --silent && node --test dist/*.test.js"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.9.4",
    "@openclaw/gateway-protocol": "2026.9.4"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "eslint": "10.10.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0"
  }
}
